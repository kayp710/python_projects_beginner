import re

def password_checker():
    # Color code for output
    GREEN = '\033[32m'
    RED = '\033[31m'
    RESET = '\033[0m'
    BLUE = '\033[34m'

    password = input("Enter your password - ")
    true = 0
    # Parameters for character count, letters, numbers, and special characters
    if len(password) < 8:
        print(RED + "x: Password should be at least 8 characters" + RESET)
    elif len(password) >= 8:
        print(GREEN + "✓: Password exceeds 8 characters" + RESET)
        true = true + 1

    if not re.search("[A-Z]", password):
        print("x: Password Must contain at least one uppercase letter" + RESET)
    else:
        print(GREEN + "✓: Password contains at least one uppercase letter" + RESET)
        true = true + 1

    if not re.search("[a-z]", password):
        print(RED + "x: Password must contain at least lowercase letter" + RESET)
    else:
        print(GREEN + "✓: Password contains at least one lowercase letter" + RESET)
        true = true + 1

    if not re.search("[0-9]", password):
        print(RED + "x: Password must contain at least one number" + RESET)
    else:
        print(GREEN + "✓: Password contains at least on number" + RESET)
        true = true + 1
    # Introduce special characters to checker
        special_characters = ["!", "@", "#", "$", "%", "^", "&", "*", "()", "<", ">", "?", ":", ";", "|", "/", "\\", "[]", "]", "}", "=", "+", "-", "_"]

    if not re.search("[special_characters]", password):
        print(RED + "x: Password must contain at least one special character" + RESET)
    else:
        print(GREEN + "✓: Password contains at least one special character" + RESET)
        true = true + 1

    if re.search("[ ]", password):
        print(RED + "x: Password must not contain spaces" + RESET)
    else:
        print(GREEN + "✓: Password does not contain spaces" + RESET)
        true = true + 1

    if true == 6:
        print(BLUE + "Password is strong" + RESET)
    elif true < 6:
        print(RED + "Password is not very strong" + RESET)



password_checker()
